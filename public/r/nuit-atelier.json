{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "nuit-atelier",
  "type": "registry:theme",
  "title": "Nuit d'atelier",
  "description": "Thème FlexiWeb de nuit : sections vert nuit alternées avec le sable, halo citron, titres d'affiche en Instrument Serif. Prolonge flexiweb-theme. Recettes CSS (.na-*) dans themes/nuit-atelier/theme.css.",
  "registryDependencies": [
    "https://raw.githubusercontent.com/yg0a1n/flexiweb-registry/main/public/r/flexiweb-theme.json"
  ],
  "cssVars": {
    "theme": {
      "font-affiche": "Instrument Serif, Fraunces, ui-serif, Georgia, serif",
      "radius-carte": "22px",
      "halo": "radial-gradient(ellipse 80% 60% at 50% 0%, rgba(154, 205, 50, 0.3), transparent 70%)",
      "halo-bas": "radial-gradient(ellipse 80% 60% at 50% 100%, rgba(154, 205, 50, 0.3), transparent 70%)",
      "ombre-carte": "0 1px 2px rgba(12, 85, 38, 0.06), 0 8px 24px -8px rgba(12, 85, 38, 0.18)"
    },
    "light": {
      "nuit": "#06200f",
      "nuit-texte": "#f6faf6",
      "nuit-attenue": "#b5c7bb",
      "nuit-filet": "rgba(255, 255, 255, 0.12)",
      "partiel-encre": "#7c4a03"
    }
  }
}
